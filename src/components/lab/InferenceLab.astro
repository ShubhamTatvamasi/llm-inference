  .lab :global(svg) { display: block; width: 100%; height: auto; overflow: visible; font-family: var(--font-sans); fill: var(--text); }
  .lab :global(svg text) { font-size: 12px; }
  .lab :global(svg .t-dim) { fill: var(--text-dim); }
  .lab :global(svg .t-faint) { fill: var(--text-faint); }
  .lab :global(svg .t-mono) { font-family: var(--font-mono); }
  .lab :global(svg .t-small) { font-size: 11px; }
  .lab :global(svg .t-bold) { font-weight: 650; }
  .lab :global(.lab-foot) { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin-top: 14px; }
  .lab :global(.lab-note) { font-size: 0.78rem; color: var(--text-faint); flex: 1; min-width: 240px; }
  .lab:global(.lab-nofit) :global(.stat .v) { color: var(--text-faint); }
  @media (max-width: 900px) {
    .lab :global(.lab-ctl), .lab :global(.lab-grid) { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .lab :global(.lab-cg .field) { flex-wrap: wrap; }
    .lab :global(.lab-cg select) { max-width: 100%; }
