  .lab :global(.lab-panel header) { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .lab :global(.lab-panel h3) { margin: 0; font-size: 0.98rem; font-weight: 650; letter-spacing: -0.01em; }
  .lab :global(.lab-learnwrap) { display: inline-flex; gap: 10px; }
  .lab :global(.lab-sub) { margin: 4px 0 8px; font-size: 0.82rem; color: var(--text-dim); line-height: 1.5; }
