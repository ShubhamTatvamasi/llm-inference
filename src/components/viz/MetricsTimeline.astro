---
/* One request's life on a time axis: queue → prefill → streamed tokens.
   Annotates queue time, TTFT, every ITL gap, TPOT and E2E. */
---
<div data-viz="metrics-timeline"></div>

<script>
  import { mountAll, svgRoot, s, rect, text, line, clear, ctrlBar, player, stats, legend, narration, C, arrowDefs, uniq } from '../../lib/viz';

  const QUEUE = 160, PREFILL = 260; // ms
  const GAPS = [42, 44, 41, 43, 45, 290, 42, 44, 43, 41, 44]; // ITL between consecutive tokens (one stall)
  const TOKENS = ['Sure', ',', ' here', '’s', ' a', ' short', ' answer', ':', ' yes', ',', ' it', ' works'];
  const TTFT = QUEUE + PREFILL;
  const TIMES: number[] = [TTFT];
  for (const g of GAPS) TIMES.push(TIMES[TIMES.length - 1] + g);
  const E2E = TIMES[TIMES.length - 1];
  const N = TOKENS.length;
  const TPOT = (E2E - TTFT) / (N - 1);

  const W = 940, H = 352, X0 = 110, X1 = 920, TMAX = 1200;
  const sx = (ms: number) => X0 + (ms / TMAX) * (X1 - X0);

  mountAll('metrics-timeline', (root) => {
    const bar = ctrlBar(root);
    let now = 0;
    const svg = svgRoot(root, W, H, { 'aria-label': 'Timeline of one streamed request with TTFT, ITL, TPOT and E2E annotated' });
    const say = narration(root);
    const st = stats(root, ['Queue time', 'TTFT', 'ITL (median / max)', 'TPOT', 'E2E latency', 'Tokens streamed']);
    legend(root, [['Waiting in queue', C.mem], ['Prefill', C.prefill], ['Decode step → token', C.decode], ['Stall (another user’s long prefill)', C.waste]]);
    const arrowId = uniq('mt-arr');

    function reset() { now = 0; }
    function step() { now = Math.min(TMAX, now + 25); return now < E2E + 60; }

    function bracket(x1: number, x2: number, y: number, label: string, color: string, sub?: string) {
      s('path', { d: `M${x1},${y - 6} L${x1},${y} L${x2},${y} L${x2},${y - 6}`, fill: 'none', stroke: color, 'stroke-width': 1.5 }, svg);
      text(svg, (x1 + x2) / 2, y + 13, label, { 'text-anchor': 'middle', class: 't-small t-bold', fill: color });
      if (sub) text(svg, (x1 + x2) / 2, y + 27, sub, { 'text-anchor': 'middle', class: 't-small t-dim t-mono' });
    }

    function render() {
      clear(svg);
      const arrow = arrowDefs(svg, arrowId, C.faint);
      // time axis
      line(svg, X0, 40, X1, 40, C.border);
      for (let t = 0; t <= TMAX; t += 200) {
        line(svg, sx(t), 36, sx(t), 44, C.borderStrong);
        text(svg, sx(t), 26, `${t} ms`, { 'text-anchor': 'middle', class: 't-small t-faint t-mono' });
      }
      text(svg, 8, 40, 'time →', { class: 't-small t-faint' });

      // lane labels
      const LS = 78, LC = 140;
      text(svg, 8, LS + 14, 'Server', { class: 't-bold t-small' });
      text(svg, 8, LS + 28, 'engine', { class: 't-faint t-small' });
      text(svg, 8, LC + 14, 'Client', { class: 't-bold t-small' });
      text(svg, 8, LC + 28, 'SSE stream', { class: 't-faint t-small' });
      rect(svg, X0, LS, X1 - X0, 34, C.surface2, { rx: 6, opacity: 0.6 });
      rect(svg, X0, LC, X1 - X0, 34, C.surface2, { rx: 6, opacity: 0.6 });

      // server phases (clipped to now)
      const seg = (a: number, b: number, fill: string, label?: string) => {
        if (now <= a) return;
        const e = Math.min(b, now);
        rect(svg, sx(a), LS + 3, sx(e) - sx(a), 28, fill, { rx: 4, opacity: 0.9 });
        if (label && sx(e) - sx(a) > 60) text(svg, sx(a) + 7, LS + 17, label, { class: 't-small t-bold', fill: 'var(--bg)' });
      };
      seg(0, QUEUE, C.mem, 'queued');
      seg(QUEUE, TTFT, C.prefill, 'prefill (whole prompt)');
      for (let i = 1; i < N; i++) {
        const a = TIMES[i - 1], b = TIMES[i];
        const stall = b - a > 100;
        if (stall) { seg(a, b - 40, C.waste, 'stalled'); seg(b - 40, b - 2, C.decode); }
        else seg(a + 1, b - 2, C.decode);
      }

      // client tokens
      for (let i = 0; i < N; i++) {
        if (now < TIMES[i]) continue;
        const x = sx(TIMES[i]);
        s('line', { x1: x, y1: LS + 33, x2: x, y2: LC + 2, stroke: C.faint, 'stroke-width': 1, 'stroke-dasharray': '2 3', 'marker-end': arrow }, svg);
        s('circle', { cx: x, cy: LC + 17, r: 6, fill: i === 0 ? C.kv : C.token }, svg);
      }
      // streamed text so far
      const shown = TOKENS.filter((_, i) => now >= TIMES[i]).join('');
      text(svg, X0, LC + 52, shown ? `“${shown}${now < E2E ? '▍' : '”'}` : '…waiting for the first token', { class: shown ? 't-mono' : 't-faint t-small', 'font-size': 13 });

      // brackets
      const BY = 222;
      if (now >= QUEUE) bracket(sx(0), sx(QUEUE), BY, 'queue', C.mem, `${QUEUE} ms`);
      if (now >= TTFT) bracket(sx(0), sx(TTFT), BY + 44, 'TTFT', C.kv, `${TTFT} ms`);
      for (let i = 1; i < N; i++) {
        if (now < TIMES[i]) break;
        const g = TIMES[i] - TIMES[i - 1];
        const a = sx(TIMES[i - 1]), b = sx(TIMES[i]);
        s('path', { d: `M${a},${BY - 4} L${a},${BY} L${b},${BY} L${b},${BY - 4}`, fill: 'none', stroke: g > 100 ? C.waste : C.decode, 'stroke-width': 1.3 }, svg);
        if (g > 100) text(svg, (a + b) / 2, BY + 13, `ITL ${g} ms`, { 'text-anchor': 'middle', class: 't-small t-bold', fill: C.waste });
      }
      if (now >= TIMES[1]) text(svg, sx(TIMES[2]), BY + 13, 'ITL ≈ 43 ms', { 'text-anchor': 'middle', class: 't-small', fill: C.decode });
      if (now >= E2E) {
        bracket(sx(TTFT), sx(E2E), BY + 44, 'decode: (N−1) × TPOT', C.decode, `${E2E - TTFT} ms / ${N - 1} = ${TPOT.toFixed(1)} ms`);
        bracket(sx(0), sx(E2E), BY + 88, 'E2E latency', C.accent, `${E2E} ms`);
      }

      // playhead
      if (now > 0 && now < TMAX) {
        line(svg, sx(now), 34, sx(now), LC + 36, C.accent, { 'stroke-width': 1.2, opacity: 0.8 });
      }

      // stats
      const got = TIMES.filter((t) => now >= t).length;
      const gapsSeen = GAPS.slice(0, Math.max(0, got - 1));
      const sorted = [...gapsSeen].sort((a, b) => a - b);
      st.set('Queue time', now >= QUEUE ? `${QUEUE} ms` : '…');
      st.set('TTFT', now >= TTFT ? `${TTFT} ms` : '…', 'queue + prefill + 1st step', C.kv);
      st.set('ITL (median / max)', sorted.length ? `${sorted[Math.floor(sorted.length / 2)]} / ${sorted[sorted.length - 1]} ms` : '…', 'gap between streamed tokens');
      st.set('TPOT', now >= E2E ? `${TPOT.toFixed(1)} ms` : '…', 'mean decode time / token');
      st.set('E2E latency', now >= E2E ? `${E2E} ms` : '…', 'TTFT + (N−1)·TPOT');
      st.set('Tokens streamed', `${got} / ${N}`);

      if (now === 0) say('Press <b>Play</b>. The request arrives at <b>t = 0</b>. The clock for every user-facing metric starts here, not when the engine picks the request up.');
      else if (now < QUEUE) say('<b>Queued.</b> All batch slots are busy, so the request waits. Queue time counts toward TTFT, but engine-side timers often miss it.');
      else if (now < TTFT) say('<b>Prefill.</b> The whole prompt goes through the model in one pass. The first token comes out at the end of this pass.');
      else if (now < TIMES[6]) say('<b>Decoding.</b> One token per engine step. Each gap between tokens is an <b>inter-token latency (ITL)</b>, about 43 ms here.');
      else if (now < TIMES[7]) say('<b>Stall!</b> Another user’s long prompt was prefilled in the same step, so this stream froze for about 290 ms. Average TPOT barely moves, but p99 ITL catches it.');
      else if (now < E2E) say('Back to steady ~43 ms ITL. The user perceives speed as <b>TTFT + smoothness</b>, not total time.');
      else say(`<b>Done.</b> TPOT = (E2E − TTFT) / (N − 1) = (${E2E} − ${TTFT}) / ${N - 1} = <b>${TPOT.toFixed(1)} ms</b>. Median ITL is only 43 ms, so one stall pulled the <i>mean</i> up by 50%.`);
    }

    player(bar, root, { step, reset, render, interval: 80, autoplay: true });
  });
</script>
