---
/* How many requests does a p99 need? Eight independent benchmark runs draw TTFTs from the
   same heavy-tailed distribution; each line is that run's running p99 estimate as the sample
   count grows. Optional cold-start requests at the beginning show what skipping warm-up does.
   Illustrative distribution (log-normal body + rare slow tail), not a measurement. */
---
<div data-viz="bench-samples"></div>

<script>
  import { mountAll, svgRoot, s, rect, text, line, clear, ctrlBar, slider, checkbox, button, stats, narration, C, rng, SERIES } from '../../lib/viz';

  const RUNS = 8, MAXN = 5000;
  const W = 940, H = 300;

  function draw(r: () => number) {
    let u = 0; while (u === 0) u = r();
    const g = Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * r());
    const body = 0.18 * Math.exp(0.45 * g); // ~180 ms median
    return r() < 0.03 ? body + 0.4 + 1.6 * -Math.log(1 - r()) * 0.5 : body; // 3% hit a long prompt / queue burst
  }

  mountAll('bench-samples', (root) => {
    let n = 300, cold = false, seed = 1;
    const bar = ctrlBar(root);
    slider(bar, { label: 'Requests per run', min: 50, max: MAXN, step: 50, value: n, format: (v) => `${v}`, onInput: (v) => { n = v; render(); } });
    checkbox(bar, 'Skip warm-up (first 20 requests cold)', cold, (v) => { cold = v; build(); render(); });
    button(bar, 'Re-run all 8', () => { seed += 8; build(); render(); }, { icon: 'reset' });

    const svg = svgRoot(root, W, H, { 'aria-label': 'Running p99 TTFT estimate for eight benchmark runs as sample count grows' });
    const st = stats(root, ['True p99 TTFT', 'p99 across 8 runs', 'Run-to-run spread', 'Samples above p99']);
    const say = narration(root);

    let truth = 0; let runs: number[][] = []; let ckEst: number[][] = [];
    // ground truth from a large sample
    { const r = rng(999); const big = Array.from({ length: 200000 }, () => draw(r)).sort((a, b) => a - b); truth = big[Math.floor(0.99 * big.length)]; }

    function build() {
      runs = Array.from({ length: RUNS }, (_, k) => {
        const r = rng(seed + k * 131);
        return Array.from({ length: MAXN }, (_, i) => draw(r) + (cold && i < 20 ? 2.5 + 3 * r() : 0));
      });
      ckEst = runs.map((run) => CK.map((c) => p99(run.slice(0, c))));
    }
    // running p99 at checkpoints (log-spaced)
    const CK = Array.from({ length: 60 }, (_, i) => Math.round(Math.pow(10, Math.log10(20) + (i / 59) * (Math.log10(MAXN) - Math.log10(20)))));
    const p99 = (a: number[]) => { const so = [...a].sort((x, y) => x - y); return so[Math.min(so.length - 1, Math.ceil(0.99 * so.length) - 1)]; };

    function render() {
      clear(svg);
      const X0 = 70, X1 = 900, Y0 = 30, Y1 = 250;
      const lx = (k: number) => X0 + ((Math.log10(k) - Math.log10(20)) / (Math.log10(MAXN) - Math.log10(20))) * (X1 - X0);
      const YMAX = 6;
      const ly = (v: number) => Y1 - (Math.log10(Math.min(YMAX, Math.max(0.2, v))) - Math.log10(0.2)) / (Math.log10(YMAX) - Math.log10(0.2)) * (Y1 - Y0);
      text(svg, X0, 12, 'Running p99 TTFT estimate, 8 independent runs', { class: 't-bold' });
      for (const [v, lab] of [[0.2, '0.2 s'], [0.5, '0.5 s'], [1, '1 s'], [2, '2 s'], [5, '5 s']] as [number, string][]) {
        line(svg, X0, ly(v), X1, ly(v), C.border, { 'stroke-width': 1 });
        text(svg, X0 - 6, ly(v), lab, { 'text-anchor': 'end', class: 't-small t-faint t-mono' });
      }
      line(svg, X0, Y1, X1, Y1, C.borderStrong, { 'stroke-width': 1 });
      for (const k of [20, 50, 100, 200, 500, 1000, 2000, 5000]) text(svg, lx(k), Y1 + 14, String(k), { 'text-anchor': 'middle', class: 't-small t-faint t-mono' });
      text(svg, (X0 + X1) / 2, Y1 + 32, 'requests measured so far (log scale)', { 'text-anchor': 'middle', class: 't-small t-dim' });
      // shaded "below 100 samples: p99 is just the max" zone
      rect(svg, X0, Y0, lx(100) - X0, Y1 - Y0, C.wasteSoft, { rx: 0, opacity: 0.5 });
      text(svg, X0 + 6, Y0 + 10, 'n < 100: "p99" is the slowest request', { class: 't-small t-bold', fill: C.waste });
      // truth band ±10%
      rect(svg, X0, ly(truth * 1.1), X1 - X0, ly(truth * 0.9) - ly(truth * 1.1), C.kvSoft, { rx: 0, opacity: 0.35 });
      line(svg, X0, ly(truth), X1, ly(truth), C.good, { 'stroke-width': 1.6, 'stroke-dasharray': '6 3' });
      text(svg, X1, ly(truth) - 9, `true p99 ${truth.toFixed(2)} s (±10% band)`, { 'text-anchor': 'end', class: 't-small t-bold', fill: C.good });

      const ests: number[] = [];
      runs.forEach((run, k) => {
        const e = p99(run.slice(0, n)); ests.push(e);
        const pts: [number, number][] = CK.map((c, i) => [c, ckEst[k][i]] as [number, number]).filter(([c]) => c < n);
        pts.push([n, e]);
        const d = pts.map(([c, v], i) => `${i ? 'L' : 'M'}${lx(c)},${ly(v)}`).join(' ');
        s('path', { d, fill: 'none', stroke: SERIES[k], 'stroke-width': 1.6, opacity: 0.85 }, svg);
        s('circle', { cx: lx(n), cy: ly(e), r: 3.5, fill: SERIES[k] }, svg);
      });
      line(svg, lx(n), Y0, lx(n), Y1, C.accent, { 'stroke-width': 1.2, opacity: 0.7 });

      const lo = Math.min(...ests), hi = Math.max(...ests);
      const spread = (hi - lo) / truth;
      st.set('True p99 TTFT', `${truth.toFixed(2)} s`, 'from 200k simulated requests', C.good);
      st.set('p99 across 8 runs', `${lo.toFixed(2)}–${hi.toFixed(2)} s`, `at ${n} requests each`);
      st.set('Run-to-run spread', `±${Math.round((spread / 2) * 100)}%`, spread < 0.2 ? 'stable enough to compare' : 'too noisy to compare configs', spread < 0.2 ? C.good : C.waste);
      st.set('Samples above p99', `${Math.max(0, Math.floor(n * 0.01))}`, 'the estimate rests on these');
      if (cold) say(`<b>No warm-up.</b> The first 20 requests paid for compilation, CUDA graph capture and a cold prefix cache. They are ${(2000 / n).toFixed(1)}% of a ${n}-request run, and the p99 rests on the slowest ~${Math.max(1, Math.floor(n * 0.01))} requests, so ${20 >= n * 0.01 ? 'the "p99" is really measuring start-up' : 'every run lands above the true p99'}. A longer run dilutes the problem slowly; excluding a warm-up phase removes it.`);
      else if (n < 100) say(`With ${n} requests the p99 is simply the worst request in the run, and different runs disagree wildly. Never quote a p99 from fewer than a few hundred requests.`);
      else if (spread > 0.2) say(`At ${n} requests, only ~${Math.floor(n * 0.01)} samples sit above the p99, so one slow request moves it a lot. A 15% "regression" between two configs here could be pure noise. Increase the run length or repeat runs and compare ranges.`);
      else say(`At ${n} requests the eight runs agree within ±${Math.round((spread / 2) * 100)}%. A rule of thumb: aim for at least ~1,000 requests (10+ above the p99) per sweep point, and repeat runs before trusting a small difference.`);
    }
    build(); render();
  });
</script>
