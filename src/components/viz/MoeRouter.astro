---
/* MoE router: each token → gate logits → softmax → top-k experts → weighted combine.
   Expert load counters accumulate so imbalance becomes visible. */
---
<div data-viz="moe-router"></div>

<script>
  import { mountAll, svgRoot, s, rect, text, clear, ctrlBar, player, segmented, checkbox, stats, narration, legend, arrowDefs, uniq, rng, C } from '../../lib/viz';

  const TOKENS = ['The', 'integral', 'of', 'cos', 'x', 'is', 'sin', 'x', '.', 'Bonjour', 'le', 'monde'];
  // "personality" of each token: preferred experts (makes routing look plausibly specialised)
  const PREF: number[][] = [[0, 6], [3, 5], [0, 6], [3, 5], [3, 1], [0, 6], [3, 5], [3, 1], [6, 0], [2, 7], [2, 0], [7, 2]];
  const NAMES = ['syntax', 'symbols', 'french', 'math', 'code', 'calculus', 'function words', 'nouns'];
  const E = 8;
  const W = 940, H = 420;

  function gate(i: number) {
    const r = rng(1000 + i * 17);
    const logits = Array.from({ length: E }, () => r() * 1.6 - 0.8);
    logits[PREF[i][0]] += 2.6; logits[PREF[i][1]] += 1.9;
    const mx = Math.max(...logits);
    const ex = logits.map((l) => Math.exp(l - mx));
    const sum = ex.reduce((a, b) => a + b, 0);
    return ex.map((x) => x / sum);
  }

  mountAll('moe-router', (root) => {
    const bar = ctrlBar(root);
    let k = 2; let shared = false;
    let idx = -1;
    let load = new Array(E).fill(0);

    const svg = svgRoot(root, W, H, { 'aria-label': 'Router assigning each token to its top-k experts' });
    const say = narration(root);
    const st = stats(root, ['Token', 'Experts used', 'Active FFN params', 'Busiest / idlest expert']);
    legend(root, [['Token', C.token], ['Gate probability', C.accent], ['Selected expert', C.compute], ['Shared expert (always on)', C.kv]]);

    function reset() { idx = -1; load = new Array(E).fill(0); }
    function stepFn() {
      if (idx >= TOKENS.length - 1) return false;
      idx++;
      const p = gate(idx);
      topk(p).forEach((e) => load[e]++);
      return idx < TOKENS.length - 1;
    }
    function topk(p: number[]) { return p.map((v, i) => [v, i]).sort((a, b) => b[0] - a[0]).slice(0, k).map((x) => x[1]); }

    function render() {
      clear(svg);
      const arrow = arrowDefs(svg, uniq('mr'), C.compute);
      // token strip
      const tx0 = 16, tw = 70;
      text(svg, tx0, 16, 'Tokens in the batch', { class: 't-small t-faint' });
      TOKENS.forEach((t, i) => {
        const y = 34 + i * 29;
        const on = i === idx;
        rect(svg, tx0, y, tw, 24, on ? C.token : i < idx ? C.tokenSoft : C.surface2, { rx: 6, stroke: on ? 'none' : C.border });
        text(svg, tx0 + tw / 2, y + 12, t, { 'text-anchor': 'middle', class: 't-small t-bold', fill: on ? 'var(--bg)' : i < idx ? C.token : C.faint });
      });

      // gate
      const gx = 160, gw = 300;
      text(svg, gx, 16, 'Router: softmax(x · W_gate)', { class: 't-small t-faint' });
      const p = idx >= 0 ? gate(idx) : new Array(E).fill(1 / E);
      const chosen = idx >= 0 ? topk(p) : [];
      const sel = chosen.reduce((a, e) => a + p[e], 0);
      for (let e = 0; e < E; e++) {
        const y = 40 + e * 44;
        const w = p[e] * gw;
        rect(svg, gx, y, gw, 30, C.surface2, { rx: 6 });
        rect(svg, gx, y, Math.max(2, w), 30, chosen.includes(e) ? C.accent : C.accentSoft, { rx: 6 });
        text(svg, gx + gw + 8, y + 15, (p[e] * 100).toFixed(0) + '%', { class: 't-small t-mono', fill: chosen.includes(e) ? C.accent : C.faint });
      }
      if (idx >= 0) {
        const ty = 34 + idx * 29 + 12;
        s('path', { d: `M${tx0 + tw},${ty} C${tx0 + tw + 40},${ty} ${gx - 40},200 ${gx - 4},200`, fill: 'none', stroke: C.token, 'stroke-width': 2 }, svg);
      }

      // experts
      const ex = 560, ew = 220;
      text(svg, ex, 16, 'Experts (each a full MLP)', { class: 't-small t-faint' });
      const maxLoad = Math.max(1, ...load);
      for (let e = 0; e < E; e++) {
        const y = 40 + e * 44;
        const on = chosen.includes(e);
        rect(svg, ex, y, ew, 30, on ? C.compute : C.surface2, { rx: 7, stroke: on ? 'none' : C.border });
        text(svg, ex + 10, y + 15, `E${e}`, { class: 't-small t-bold t-mono', fill: on ? 'var(--bg)' : C.text });
        text(svg, ex + 38, y + 15, NAMES[e], { class: 't-small', fill: on ? 'var(--bg)' : C.dim });
        // load bar
        rect(svg, ex + ew + 10, y + 8, 80, 14, C.surface3, { rx: 4 });
        rect(svg, ex + ew + 10, y + 8, (load[e] / maxLoad) * 80, 14, C.compute, { rx: 4, opacity: 0.7 });
        text(svg, ex + ew + 96, y + 15, String(load[e]), { class: 't-small t-mono t-dim' });
        if (on) {
          const w = p[e] / sel;
          s('path', { d: `M${gx + p[e] * 300 + 4},${y + 15} L${ex - 6},${y + 15}`, fill: 'none', stroke: C.compute, 'stroke-width': 1 + 3 * w, 'marker-end': arrow }, svg);
          rect(svg, (gx + 300 + ex) / 2 - 2, y + 2, 46, 18, C.surface, { rx: 9, stroke: C.compute });
          text(svg, (gx + 300 + ex) / 2 + 21, y + 11, `×${w.toFixed(2)}`, { 'text-anchor': 'middle', class: 't-small t-mono', fill: C.compute });
        }
      }
      text(svg, ex + ew + 10, 30, 'tokens routed', { class: 't-small t-faint' });
      if (shared) {
        rect(svg, ex, 40 + E * 44 - 4, ew, 22, C.kv, { rx: 7 });
        text(svg, ex + 10, 40 + E * 44 + 7, 'Shared expert: every token', { class: 't-small t-bold', fill: 'var(--bg)' });
      }

      // stats + narration
      const sorted = [...load].sort((a, b) => b - a);
      st.set('Token', idx >= 0 ? `“${TOKENS[idx]}”` : '–', idx >= 0 ? `${idx + 1} of ${TOKENS.length}` : '');
      st.set('Experts used', `${k + (shared ? 1 : 0)} of ${E + (shared ? 1 : 0)}`, `top-${k}${shared ? ' + shared' : ''}`);
      st.set('Active FFN params', `${(((k + (shared ? 1 : 0)) / (E + (shared ? 1 : 0))) * 100).toFixed(0)}%`, 'of all expert weights, per token');
      st.set('Busiest / idlest expert', idx >= 0 ? `${sorted[0]} / ${sorted[E - 1]}` : '–', 'tokens so far', sorted[0] > 2 * (sorted[E - 1] + 1) ? C.waste : undefined);
      if (idx < 0) say('Press <b>Play</b>. Each token is scored by a tiny <b>router</b> (one linear layer), which picks the top-k experts for it.');
      else {
        say(`“<b>${TOKENS[idx]}</b>” → ${chosen.map((e) => `E${e}`).join(', ')}. ${k > 1 ? `Their outputs are mixed with the renormalised gate weights (${chosen.map((e) => (p[e] / sel).toFixed(2)).join(' / ')}).` : 'With top-1 the single expert gets weight 1.00.'} The other ${E - k} experts do <b>no work</b> for this token, but their weights still sit in GPU memory.`);
      }
    }

    player(bar, root, { step: stepFn, reset, render, interval: 1200, autoplay: true, loop: true });
    segmented(bar, [{ value: '1', label: 'top-1' }, { value: '2', label: 'top-2' }, { value: '4', label: 'top-4' }], '2', (v) => { k = Number(v); reset(); render(); });
    checkbox(bar, 'Shared expert', shared, (v) => { shared = v; render(); });
  });
</script>
