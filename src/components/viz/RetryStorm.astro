---
/* 1,000 clients hit an endpoint that is down for 10 s, then recovers with limited capacity.
   Compare retry strategies: fixed 1 s, exponential backoff, exponential backoff + full jitter. */
---
<div data-viz="retry-storm"></div>

<script>
  import { mountAll, svgRoot, rect, text, line, clear, ctrlBar, segmented, slider, stats, legend, narration, C, rng } from '../../lib/viz';

  type Strat = 'fixed' | 'exp' | 'jitter';
  const CLIENTS = 1000, DOWN = 10, HORIZON = 60, DT = 0.25;

  function simulate(strat: Strat, cap: number) {
    const r = rng(9);
    const buckets = Math.round(HORIZON / DT);
    const attempts = new Array(buckets).fill(0), served = new Array(buckets).fill(0);
    // each client: next attempt time + attempt count
    let pending = Array.from({ length: CLIENTS }, () => ({ t: r() * 2, k: 0 }));
    let doneAt = -1, totalAttempts = 0;
    for (let b = 0; b < buckets; b++) {
      const t0 = b * DT, t1 = t0 + DT;
      const now = pending.filter((c) => c.t >= t0 && c.t < t1);
      if (!now.length) { if (!pending.length && doneAt < 0) doneAt = t0; continue; }
      attempts[b] = now.length; totalAttempts += now.length;
      const raw = t0 < DOWN ? 0 : cap * DT;
      // rejecting excess traffic is not free (TLS, auth, parsing): it eats into useful capacity
      const capB = raw / (1 + 0.3 * Math.max(0, now.length - raw) / Math.max(raw, 1)); // congestion collapse
      // shuffle-ish: serve a random subset up to capacity
      const ok = new Set<number>();
      const idx = now.map((_, i) => i).sort(() => r() - 0.5).slice(0, Math.floor(capB));
      idx.forEach((i) => ok.add(i));
      served[b] = ok.size;
      const okClients = new Set(now.filter((_, i) => ok.has(i)));
      pending = pending.filter((c) => !okClients.has(c));
      for (const c of now) {
        if (okClients.has(c)) continue;
        c.k++;
        const backoff = Math.min(8, Math.pow(2, c.k - 1)); // 1, 2, 4, 8 s cap
        const delay = strat === 'fixed' ? 1 : strat === 'exp' ? backoff : r() * backoff; // full jitter: U(0, backoff)
        c.t = Math.max(t1, c.t + delay);
      }
    }
    if (doneAt < 0 && !pending.length) doneAt = HORIZON;
    return { attempts, served, doneAt, totalAttempts, left: pending.length };
  }

  const W = 940, H = 262, X0 = 50, X1 = 920, Y0 = 32, Y1 = 230;

  mountAll('retry-storm', (root) => {
    let strat: Strat = 'fixed', cap = 120;
    const bar = ctrlBar(root);
    segmented(bar, [{ value: 'fixed', label: 'Retry every 1 s' }, { value: 'exp', label: 'Exponential backoff' }, { value: 'jitter', label: 'Backoff + full jitter' }], strat, (v) => { strat = v as Strat; render(); });
    slider(bar, { label: 'Capacity after recovery', min: 40, max: 300, step: 10, value: cap, format: (v) => `${v} req/s`, onInput: (v) => { cap = v; render(); } });
    const svg = svgRoot(root, W, H, { 'aria-label': 'Attempts per second after an outage for different retry strategies' });
    legend(root, [['Attempts / s hitting the server', C.prefill], ['Succeeded', C.kv], ['Server capacity', C.waste]]);
    const st = stats(root, ['Peak load', 'Total attempts', 'All 1,000 clients served after']);
    const say = narration(root);

    function render() {
      clear(svg);
      const res = simulate(strat, cap);
      const perSec = res.attempts.map((a) => a / DT);
      const ymax = Math.max(400, Math.ceil(Math.max(...perSec) / 200) * 200);
      const sy = (v: number) => Y1 - (v / ymax) * (Y1 - Y0);
      const bw = (X1 - X0) / res.attempts.length;
      rect(svg, X0, Y0, (DOWN / HORIZON) * (X1 - X0), Y1 - Y0, C.wasteSoft, { rx: 0 });
      text(svg, X0 + 6, Y0 + 12, 'outage', { class: 't-small t-bold', fill: C.waste });
      for (let v = 0; v <= ymax; v += ymax / 4) {
        line(svg, X0, sy(v), X1, sy(v), C.border, { 'stroke-width': 1 });
        text(svg, X0 - 6, sy(v), String(Math.round(v)), { 'text-anchor': 'end', class: 't-small t-faint t-mono' });
      }
      res.attempts.forEach((a, b) => {
        if (!a) return;
        const x = X0 + b * bw;
        rect(svg, x + 0.5, sy(a / DT), Math.max(1, bw - 1), Y1 - sy(a / DT), C.prefill, { rx: 1, opacity: 0.75 });
        if (res.served[b]) rect(svg, x + 0.5, sy(res.served[b] / DT), Math.max(1, bw - 1), Y1 - sy(res.served[b] / DT), C.kv, { rx: 1 });
      });
      line(svg, X0 + (DOWN / HORIZON) * (X1 - X0), sy(cap), X1, sy(cap), C.waste, { 'stroke-dasharray': '5 4', 'stroke-width': 1.5 });
      text(svg, X1, sy(cap) - 8, `capacity ${cap}/s`, { 'text-anchor': 'end', class: 't-small t-bold', fill: C.waste });
      for (let s2 = 0; s2 <= HORIZON; s2 += 10) text(svg, X0 + (s2 / HORIZON) * (X1 - X0), Y1 + 16, `${s2}s`, { 'text-anchor': 'middle', class: 't-small t-faint t-mono' });
      text(svg, X0 - 44, Y0 - 6, 'req/s', { class: 't-small t-faint' });

      const peak = Math.max(...perSec.slice(Math.round(DOWN / DT)));
      st.set('Peak load', `${Math.round(peak)}/s`, `${(peak / cap).toFixed(1)}× capacity after recovery`, peak > cap * 2 ? C.waste : undefined);
      st.set('Total attempts', res.totalAttempts.toLocaleString('en-US'), `${(res.totalAttempts / CLIENTS).toFixed(1)} per client`);
      st.set('All 1,000 clients served after', res.left ? `> ${HORIZON} s (${res.left} still waiting)` : `${res.doneAt.toFixed(1)} s`, undefined, res.left ? C.waste : C.good);
      const msg: Record<Strat, string> = {
        fixed: '<b>Fixed 1 s retries</b> keep the full crowd hammering the server every second. After recovery, most attempts get a 429, retry a second later, and the server spends its capacity rejecting traffic. This is a <b>retry storm</b>.',
        exp: '<b>Exponential backoff</b> reduces total attempts, but every client that failed together retries together. The load arrives in synchronised waves at 1, 2, 4, 8… seconds, far above capacity each time, with idle gaps in between.',
        jitter: '<b>Backoff + full jitter</b> spreads each client’s retry randomly across its backoff window. Arrivals smooth out close to capacity, nearly every attempt succeeds, and the backlog drains fastest.',
      };
      say(msg[strat] + ' Servers help by returning <code>429</code> with a <code>Retry-After</code> header, and gateways by capping retries.');
    }
    render();
  });
</script>

<style is:global>
  [data-viz='retry-storm'] .seg { flex-wrap: wrap; }
</style>
