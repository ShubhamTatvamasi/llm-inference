---
/* A day of traffic against an autoscaler. Choose the scaling signal, cold-start time,
   min replicas and scheduled pre-scaling; see SLO-violating minutes vs GPU-hours. */
---
<div data-viz="autoscale-sim"></div>

<script>
  import { mountAll, svgRoot, s, rect, text, line, clear, ctrlBar, slider, segmented, checkbox, stats, legend, narration, C, rng } from '../../lib/viz';

  type Signal = 'gpu' | 'queue' | 'kv';
  const KNOTS: [number, number][] = [[0, 3], [6, 2], [7.5, 6], [9, 26], [10, 37], [11, 32], [12.5, 23], [14, 30], [17, 26], [19, 12], [21, 6], [24, 3]];
  const CAP = 6;        // req/s one replica serves within SLO
  const MAXR = 12, COOLDOWN = 10, PRICE = 2.5; // replicas, minutes, $/GPU-hour

  const demand: number[] = (() => {
    const r = rng(21); const out: number[] = [];
    for (let m = 0; m < 1440; m++) {
      const hh = m / 60; let k = 0; while (KNOTS[k + 1][0] < hh) k++;
      const [h0, v0] = KNOTS[k], [h1, v1] = KNOTS[k + 1];
      const base = v0 + ((hh - h0) / (h1 - h0)) * (v1 - v0);
      out.push(Math.max(0.5, base * (1 + (r() - 0.5) * 0.12)));
    }
    return out;
  })();

  function run(signal: Signal, cold: number, minR: number, sched: boolean) {
    let ready = Math.max(minR, 1);
    if (minR === 0) ready = 0;
    const pending: number[] = []; // minutes when each launching replica becomes ready
    let lowSince = -1;
    const R: number[] = [], viol: boolean[] = [];
    let late = 0, total = 0, gpuMin = 0, peak = 0;
    for (let m = 0; m < 1440; m++) {
      // replicas finishing cold start
      for (let i = pending.length - 1; i >= 0; i--) if (pending[i] <= m) { pending.splice(i, 1); ready++; }
      const d = demand[m];
      const capNow = ready * CAP;
      // the signal the autoscaler sees → desired replicas
      let desired: number;
      if (ready === 0) desired = d > 0.5 ? 1 : 0; // scale-from-zero: first request triggers one replica
      else if (signal === 'gpu') { const util = Math.min(1, 0.7 + 0.3 * d / capNow); desired = Math.ceil(ready * util / 0.85); }
      else if (signal === 'queue') desired = d > capNow ? Math.ceil(d / CAP) : d < 0.5 * capNow ? Math.ceil(d / (CAP * 0.7)) : ready;
      else desired = Math.ceil((0.9 * d / CAP) / 0.7);
      const floor = sched && m >= 8 * 60 && m < 18 * 60 ? 6 : minR;
      desired = Math.min(MAXR, Math.max(floor, desired));
      const inflight = ready + pending.length;
      if (desired > inflight) { for (let i = 0; i < desired - inflight; i++) pending.push(m + cold); lowSince = -1; }
      else if (desired < ready) { if (lowSince < 0) lowSince = m; if (m - lowSince >= COOLDOWN) { ready = desired; lowSince = -1; } }
      else lowSince = -1;
      R.push(ready);
      const over = Math.max(0, d - ready * CAP);
      viol.push(over > 0.05);
      late += over * 60; total += d * 60; gpuMin += ready + pending.length; // launching GPUs cost money too
      peak = Math.max(peak, ready);
    }
    return { R, viol, late, total, gpuH: gpuMin / 60, peak, violMin: viol.filter(Boolean).length };
  }

  const W = 940, H = 290, X0 = 46, X1 = 900, Y0 = 34, Y1 = 256, YMAX = 48;
  const sx = (m: number) => X0 + (m / 1440) * (X1 - X0);
  const sy = (v: number) => Y1 - (Math.min(v, YMAX) / YMAX) * (Y1 - Y0);

  mountAll('autoscale-sim', (root) => {
    let signal: Signal = 'queue', cold = 8, minR = 1, sched = false;
    const bar = ctrlBar(root);
    segmented(bar, [{ value: 'gpu', label: 'GPU utilisation' }, { value: 'queue', label: 'Queue depth' }, { value: 'kv', label: 'KV-cache usage' }], signal, (v) => { signal = v as Signal; render(); });
    const bar2 = ctrlBar(root);
    slider(bar2, { label: 'Cold start', min: 1, max: 20, value: cold, format: (v) => `${v} min`, onInput: (v) => { cold = v; render(); } });
    slider(bar2, { label: 'Min replicas', min: 0, max: 4, value: minR, onInput: (v) => { minR = v; render(); } });
    checkbox(bar2, 'Scheduled pre-scale 08:00–18:00 (floor 6)', sched, (v) => { sched = v; render(); });
    const svg = svgRoot(root, W, H, { 'aria-label': 'Demand over a day vs autoscaled capacity, with SLO violations' });
    legend(root, [['Demand (req/s)', C.decode], ['Ready capacity (replicas × 6 req/s)', C.kv], ['SLO violated (demand > capacity)', C.waste]]);
    const st = stats(root, ['SLO-violating minutes', 'Requests served late', 'GPU-hours / day', 'Cost / day (est.)', 'Peak replicas']);
    const say = narration(root);

    function render() {
      clear(svg);
      const res = run(signal, cold, minR, sched);
      // violations
      res.viol.forEach((v, m) => { if (v) rect(svg, sx(m), Y0, sx(m + 1) - sx(m) + 0.4, Y1 - Y0, C.wasteSoft, { rx: 0 }); });
      // grid
      for (let v = 0; v <= YMAX; v += 12) {
        line(svg, X0, sy(v), X1, sy(v), C.border, { 'stroke-width': 1 });
        text(svg, X0 - 8, sy(v), String(v), { 'text-anchor': 'end', class: 't-small t-faint t-mono' });
        if (v > 0) text(svg, X1 + 6, sy(v), `${v / CAP} rep`, { class: 't-small t-faint t-mono' });
      }
      for (let hh = 0; hh <= 24; hh += 3) text(svg, sx(hh * 60), Y1 + 16, `${String(hh).padStart(2, '0')}:00`, { 'text-anchor': 'middle', class: 't-small t-faint t-mono' });
      text(svg, X0 - 40, Y0 - 8, 'req/s', { class: 't-small t-faint' });
      // demand area
      const dp = demand.map((d, m) => `${sx(m)},${sy(d)}`).join(' ');
      s('polygon', { points: `${sx(0)},${Y1} ${dp} ${sx(1439)},${Y1}`, fill: C.decodeSoft }, svg);
      s('polyline', { points: dp, fill: 'none', stroke: C.decode, 'stroke-width': 1.4 }, svg);
      // capacity step line
      let d = `M${sx(0)},${sy(res.R[0] * CAP)}`;
      for (let m = 1; m < 1440; m++) if (res.R[m] !== res.R[m - 1]) d += ` H${sx(m)} V${sy(res.R[m] * CAP)}`;
      d += ` H${sx(1440)}`;
      s('path', { d, fill: 'none', stroke: C.kv, 'stroke-width': 2.2 }, svg);
      line(svg, X0, Y1, X1, Y1, C.borderStrong, { 'stroke-width': 1 });

      const pctLate = res.late / res.total;
      st.set('SLO-violating minutes', `${res.violMin}`, `${(res.violMin / 14.4).toFixed(1)}% of the day`, res.violMin > 30 ? C.waste : C.good);
      st.set('Requests served late', `${(pctLate * 100).toFixed(1)}%`, 'demand above ready capacity', pctLate > 0.01 ? C.waste : C.good);
      st.set('GPU-hours / day', res.gpuH.toFixed(0), 'incl. replicas still starting');
      st.set('Cost / day (est.)', `$${Math.round(res.gpuH * PRICE)}`, `at $${PRICE}/GPU-h, 1 GPU/replica`);
      st.set('Peak replicas', String(res.peak));

      const msg: Record<Signal, string> = {
        gpu: '<b>GPU utilisation</b> is a poor signal. A decode loop keeps the GPU "busy" at modest load, so the metric hovers high all night and scale-down rarely happens. Once it saturates at 100% it no longer says <i>how far</i> over capacity you are, so scale-up crawls one replica at a time.',
        queue: '<b>Queue depth</b> is honest but <b>reactive</b>: it only rises once users are already waiting, and each new replica then needs a full cold start. Shorten the cold start or add pre-scaling to close the gap.',
        kv: '<b>KV-cache usage</b> (with a 70% target) rises <i>before</i> requests start queueing, so it buys a head start equal to the headroom. It is usually the best single engine signal. Combine it with queue depth for safety.',
      };
      let extra = '';
      if (minR === 0) extra = ' <b>Scale-to-zero</b>: the day starts with no replica, so the first users wait a full cold start (the red block at 00:00). Fine for batch jobs, painful for a known daily rush.';
      else if (sched) extra = ' The <b>scheduled floor</b> pre-warms capacity before the 09:00 ramp, so violations drop at the cost of some idle GPU time.';
      say(msg[signal] + extra);
    }
    render();
  });
</script>

<style is:global>
  [data-viz='autoscale-sim'] .seg { flex-wrap: wrap; }
</style>
