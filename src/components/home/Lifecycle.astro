---
/* Home hero: a live, clickable map of one request's full lifecycle. */
import { chapterUrl } from '../../lib/url';
const links = {
  client: chapterUrl('serving-stack'), gateway: chapterUrl('serving-stack'), router: chapterUrl('routing-autoscaling'),
  tokenizer: chapterUrl('tokenization'), scheduler: chapterUrl('scheduler'), prefill: chapterUrl('prefill-decode'),
  decode: chapterUrl('prefill-decode'), kv: chapterUrl('kv-cache'), weights: chapterUrl('gpu'),
  sampler: chapterUrl('sampling'), detok: chapterUrl('tokenization'), batching: chapterUrl('batching'),
};
---
<div class="lc-wrap">
  <div class="lc-scroll"><div class="lc" data-viz="lifecycle" data-links={JSON.stringify(links)}></div></div>
  <div class="lc-hud">
    <div class="hud-item"><span class="hud-k">Phase</span><span class="hud-v" data-hud="phase">—</span></div>
    <div class="hud-item"><span class="hud-k">TTFT (slow-mo)</span><span class="hud-v" data-hud="ttft">—</span></div>
    <div class="hud-item"><span class="hud-k">Tokens out</span><span class="hud-v" data-hud="tok">0</span></div>
    <div class="hud-item"><span class="hud-k">KV cache</span><span class="hud-v" data-hud="kv">0 tokens</span></div>
    <button class="btn hud-btn" type="button" data-hud="pause">Pause</button>
  </div>
</div>

<script>
  import { mountAll, svgRoot, s, rect, text, clear, rafLoop, C, ease, clamp, reducedMotion } from '../../lib/viz';

  const W = 1100, H = 450;
  const PROMPT = ['Why', ' is', ' the', ' sky', ' blue', '?'];
  const REPLY = ['Sunlight', ' scatters', ' off', ' air', ' molecules', ';', ' blue', ' light', ' scatters', ' most', '.'];
  const T = { travel: 1.2, tok: 2.0, sched: 2.6, prefill: 3.7, step: 0.62 };
  const DECODE_END = T.prefill + REPLY.length * T.step;
  const CYCLE = DECODE_END + 2.4;
  const KV_CAP = 20;

  type P = [number, number];
  function along(pts: P[], f: number): P {
    const segs = pts.slice(1).map((p, i) => Math.hypot(p[0] - pts[i][0], p[1] - pts[i][1]));
    const total = segs.reduce((a, b) => a + b, 0);
    let d = clamp(f, 0, 1) * total;
    for (let i = 0; i < segs.length; i++) {
      if (d <= segs[i]) { const t = d / segs[i]; return [pts[i][0] + (pts[i + 1][0] - pts[i][0]) * t, pts[i][1] + (pts[i + 1][1] - pts[i][1]) * t]; }
      d -= segs[i];
    }
    return pts[pts.length - 1];
  }
  const FWD: P[] = [[196, 186], [505, 186], [505, 100], [534, 100]];
  const RET: P[] = [[968, 372], [968, 412], [106, 412], [106, 372]];

  mountAll('lifecycle', (root) => {
    const links = JSON.parse(root.dataset.links || '{}') as Record<string, string>;
    const hud = (k: string) => root.closest('.lc-wrap')!.querySelector<HTMLElement>(`[data-hud="${k}"]`)!;
    const svg = svgRoot(root, W, H, { 'aria-label': 'Animated lifecycle of one LLM request from client to GPU and back' });
    const defs = s('defs', {}, svg);
    const glow = s('filter', { id: 'lc-glow', x: '-50%', y: '-50%', width: '200%', height: '200%' }, defs);
    s('feGaussianBlur', { stdDeviation: 4, result: 'b' }, glow);
    const m = s('feMerge', {}, glow); s('feMergeNode', { in: 'b' }, m); s('feMergeNode', { in: 'SourceGraphic' }, m);
    const grad = s('linearGradient', { id: 'lc-grad', x1: 0, y1: 0, x2: 1, y2: 0 }, defs);
    s('stop', { offset: 0, 'stop-color': '#a78bfa' }, grad); s('stop', { offset: 1, 'stop-color': '#22d3ee' }, grad);

    // ---------- static layer
    const stat = s('g', {}, svg);
    const stage: Record<string, SVGRectElement> = {};
    function node(key: string, x: number, y: number, w: number, h: number, title: string, sub: string, color: string) {
      const a = s('a', { href: links[key] ?? '#', class: 'lc-node' }, stat);
      s('title', { text: `${title} — open chapter` }, a);
      const r = rect(a, x, y, w, h, C.surface2, { rx: 12, stroke: C.border, 'stroke-width': 1.2 });
      rect(a, x, y + 10, 3, h - 20, color, { rx: 2 });
      text(a, x + 14, y + 20, title, { class: 't-bold', 'font-size': 13 });
      text(a, x + 14, y + 38, sub, { class: 't-dim', 'font-size': 10.5 });
      stage[key] = r;
      return r;
    }
    // paths
    s('path', { d: `M${FWD.map((p) => p.join(',')).join(' L')}`, fill: 'none', stroke: C.borderStrong, 'stroke-width': 1.5, 'stroke-dasharray': '4 5' }, stat);
    s('path', { d: `M${RET.map((p) => p.join(',')).join(' L')}`, fill: 'none', stroke: C.borderStrong, 'stroke-width': 1.5, 'stroke-dasharray': '4 5' }, stat);
    text(stat, 540, 426, 'SSE stream · one chunk per token', { 'text-anchor': 'middle', class: 't-faint', 'font-size': 10.5 });
    text(stat, 351, 144, 'POST /v1/chat/completions', { 'text-anchor': 'middle', class: 't-faint t-mono', 'font-size': 10 });

    // client
    rect(stat, 16, 40, 180, 332, C.surface, { rx: 16, stroke: C.border });
    text(stat, 32, 62, 'Client', { class: 't-bold', 'font-size': 13 });
    text(stat, 180, 62, 'app / SDK', { class: 't-faint', 'text-anchor': 'end', 'font-size': 10.5 });
    rect(stat, 54, 78, 128, 30, C.accentSoft, { rx: 10 });
    text(stat, 118, 93, PROMPT.join(''), { 'text-anchor': 'middle', 'font-size': 11.5 });
    const replyG = s('g', {}, svg);

    node('gateway', 228, 160, 108, 56, 'Gateway', 'auth · quotas', C.mem);
    node('router', 366, 160, 108, 56, 'Router', 'KV-aware pick', C.comm);

    // engine
    rect(stat, 512, 22, 576, 366, 'transparent', { rx: 18, stroke: C.borderStrong, 'stroke-dasharray': '2 4' });
    text(stat, 530, 40, 'INFERENCE ENGINE', { class: 't-faint t-bold', 'font-size': 10, 'letter-spacing': '0.12em' });
    node('tokenizer', 534, 72, 128, 70, 'Tokenizer', 'text → token IDs', C.token);
    node('scheduler', 534, 168, 128, 96, 'Scheduler', 'continuous batch', C.decode);
    // GPU
    rect(stat, 684, 56, 386, 232, C.surface, { rx: 16, stroke: C.border });
    text(stat, 700, 76, 'GPU', { class: 't-bold', 'font-size': 12 });
    text(stat, 1056, 76, 'forward pass ×L layers', { class: 't-faint', 'text-anchor': 'end', 'font-size': 10.5 });
    node('prefill', 700, 90, 172, 66, 'Prefill', 'whole prompt, 1 pass', C.prefill);
    node('decode', 884, 90, 172, 66, 'Decode', '1 token / step', C.decode);
    node('kv', 700, 172, 356, 50, 'KV cache', '', C.kv);
    node('weights', 700, 230, 356, 46, 'Weights in HBM', 'read every step', C.weight);
    node('sampler', 700, 312, 172, 56, 'Sampler', 'logits → token', C.token);
    node('detok', 884, 312, 172, 56, 'Detokenizer', 'IDs → text', C.token);
    // kv slots
    const kvSlots: SVGRectElement[] = [];
    for (let i = 0; i < KV_CAP; i++) kvSlots.push(rect(stat, 806 + i * 12.2, 186, 9.6, 22, C.surface3, { rx: 2, 'pointer-events': 'none' }));
    // loop arrow
    const loop = s('g', { 'pointer-events': 'none' }, stat);
    s('circle', { cx: 1030, cy: 112, r: 11, fill: 'none', stroke: C.decode, 'stroke-width': 1.6, 'stroke-dasharray': '50 20' }, loop);
    // scheduler slots
    const schedSlots: SVGRectElement[] = [];
    for (let i = 0; i < 4; i++) schedSlots.push(rect(stat, 548 + i * 26, 228, 20, 22, C.surface3, { rx: 4, 'pointer-events': 'none' }));

    const dyn = s('g', { 'pointer-events': 'none' }, svg);
    let paused = false; let t = 0;

    // Phones: the diagram is wider than the screen, so glide the scroller to keep the active
    // stage in view. A touch/scroll by the reader pauses following for a few seconds.
    const scroller = root.closest<HTMLElement>('.lc-scroll');
    let userUntil = 0;
    if (scroller) for (const ev of ['pointerdown', 'touchstart', 'wheel']) scroller.addEventListener(ev, () => { userUntil = performance.now() + 5000; }, { passive: true });
    function follow(xView: number) {
      if (!scroller || scroller.scrollWidth <= scroller.clientWidth + 4 || performance.now() < userUntil) return;
      const svgEl = svg as unknown as SVGSVGElement;
      const px = svgEl.getBoundingClientRect().left - scroller.getBoundingClientRect().left + scroller.scrollLeft + (xView / W) * svgEl.clientWidth;
      const target = clamp(px - scroller.clientWidth / 2, 0, scroller.scrollWidth - scroller.clientWidth);
      const next = scroller.scrollLeft + (target - scroller.scrollLeft) * (reducedMotion() ? 1 : 0.08);
      if (Math.abs(next - scroller.scrollLeft) > 0.5) scroller.scrollLeft = next;
    }
    const btn = hud('pause');
    const lp = rafLoop(root, (dt) => {
      if (paused) return;
      t = (t + dt) % CYCLE;
      draw(t);
    });
    btn.addEventListener('click', () => { paused = !paused; btn.textContent = paused ? 'Play' : 'Pause'; });
    if (reducedMotion()) { paused = true; btn.textContent = 'Play'; t = T.prefill + 5 * T.step; draw(t); }
    void lp;

    function setActive(keys: string[]) {
      for (const [k, r] of Object.entries(stage)) {
        const on = keys.includes(k);
        r.setAttribute('stroke', on ? 'url(#lc-grad)' : C.border);
        r.setAttribute('stroke-width', on ? '2' : '1.2');
        r.setAttribute('filter', on ? 'url(#lc-glow)' : '');
      }
    }

    function draw(t: number) {
      clear(dyn); clear(replyG);
      const fade = t > CYCLE - 0.6 ? (CYCLE - t) / 0.6 : 1;
      dyn.setAttribute('opacity', String(fade)); replyG.setAttribute('opacity', String(fade));
      let phase = ''; const active: string[] = [];
      const decoded = t < T.prefill ? 0 : Math.min(REPLY.length, Math.floor((t - T.prefill) / T.step) + 1);
      const arrived = t < T.prefill ? 0 : Math.min(REPLY.length, Math.max(0, Math.floor((t - T.prefill - T.step) / T.step) + 1));

      if (t < T.travel) {
        phase = 'Request in flight'; const f = ease(t / T.travel);
        const [x, y] = along(FWD, f);
        s('circle', { cx: x, cy: y, r: 6, fill: C.accent, filter: 'url(#lc-glow)' }, dyn);
        if (f > 0.15 && f < 0.45) active.push('gateway'); else if (f >= 0.45 && f < 0.75) active.push('router');
      } else if (t < T.tok) {
        phase = 'Tokenizing'; active.push('tokenizer');
        const n = Math.ceil(((t - T.travel) / (T.tok - T.travel)) * PROMPT.length);
        for (let i = 0; i < n; i++) rect(dyn, 548 + i * 18, 118, 14, 14, C.token, { rx: 3 });
      } else if (t < T.sched) {
        phase = 'Queued → admitted'; active.push('scheduler');
        rect(dyn, 548, 228, 20, 22, C.token, { rx: 4 });
      } else if (t < T.prefill) {
        phase = 'Prefill (compute-bound)'; active.push('prefill', 'weights', 'kv');
        const f = (t - T.sched) / (T.prefill - T.sched);
        rect(dyn, 716, 140, 140 * f, 6, C.prefill, { rx: 3 });
      } else if (t < DECODE_END) {
        phase = 'Decode (memory-bound)'; active.push('decode', 'weights', 'kv');
        const local = ((t - T.prefill) % T.step) / T.step;
        if (local > 0.55) active.push('sampler'); if (local > 0.8) active.push('detok');
        loop.setAttribute('transform', `rotate(${t * 240} 1030 112)`);
        rect(dyn, 900, 140, 140 * local, 6, C.decode, { rx: 3 });
      } else { phase = 'Done · KV blocks freed'; }
      setActive(active);
      follow(t < T.travel ? along(FWD, ease(t / T.travel))[0] : t < T.sched ? 600 : t < T.prefill ? 790 : t < DECODE_END ? 900 : 110);

      // scheduler shows a running batch during work
      schedSlots.forEach((r, i) => r.setAttribute('fill', t >= T.sched && t < DECODE_END ? (i === 0 ? C.token : i < 3 ? C.decodeSoft : C.surface3) : C.surface3));

      // KV slots
      const kvN = t < T.sched ? 0 : t < T.prefill ? Math.round(PROMPT.length * clamp((t - T.sched) / (T.prefill - T.sched), 0, 1)) : t < DECODE_END ? PROMPT.length + decoded : 0;
      kvSlots.forEach((r, i) => r.setAttribute('fill', i < Math.min(kvN, PROMPT.length) ? C.prefill : i < kvN ? C.kv : C.surface3));
      text(dyn, 714, 210, `${kvN} tokens`, { class: 't-mono', 'font-size': 10.5, fill: C.kv });

      // tokens on the return path
      if (t >= T.prefill && t < DECODE_END + T.step) {
        for (let k = 0; k < decoded; k++) {
          const born = T.prefill + (k + 1) * T.step;
          const f = (t - born + T.step * 0.2) / (T.step * 1.6);
          if (f > 0 && f < 1) {
            const [x, y] = along(RET, ease(f));
            rect(dyn, x - 6, y - 6, 12, 12, C.decode, { rx: 3, filter: 'url(#lc-glow)' });
          }
        }
      }
      // reply text in client
      const words = REPLY.slice(0, arrived);
      const lines: string[] = []; let cur = '';
      for (const w of words) { if ((cur + w).length > 18) { lines.push(cur.trim()); cur = w; } else cur += w; }
      if (cur) lines.push(cur.trim());
      if (arrived > 0 || (t >= T.prefill && t < DECODE_END)) {
        rect(replyG, 30, 124, 140, 30 + lines.length * 17, C.surface2, { rx: 10, stroke: C.border });
        text(replyG, 42, 138, 'assistant', { class: 't-faint', 'font-size': 10 });
        lines.forEach((l, i) => text(replyG, 42, 156 + i * 17, l + (i === lines.length - 1 && arrived < REPLY.length ? ' ▍' : ''), { 'font-size': 12 }));
      }

      hud('phase').textContent = phase;
      hud('ttft').textContent = arrived > 0 ? `${(T.prefill + T.step).toFixed(1)} s` : '—';
      hud('tok').textContent = String(arrived);
      hud('kv').textContent = `${kvN} tokens`;
    }
  });
</script>

<style>
  .lc-wrap { position: relative; border: 1px solid var(--border); border-radius: 22px; background: var(--surface); backdrop-filter: blur(16px); box-shadow: var(--shadow), 0 40px 120px -40px rgba(124, 92, 255, 0.35); overflow: hidden; }
  .lc-wrap::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(167,139,250,0.8), rgba(34,211,238,0.7), transparent); }
  .lc-scroll { overflow-x: auto; scrollbar-width: thin; }
  .lc { min-width: 820px; padding: 14px 14px 4px; }
  .lc :global(svg) { display: block; width: 100%; height: auto; font-family: var(--font-sans); fill: var(--text); }
  .lc :global(.t-dim) { fill: var(--text-dim); }
  .lc :global(.t-faint) { fill: var(--text-faint); }
  .lc :global(.t-bold) { font-weight: 650; }
  .lc :global(.t-mono) { font-family: var(--font-mono); }
  .lc :global(.lc-node) { cursor: pointer; }
  .lc :global(.lc-node:hover rect:first-of-type) { fill: var(--surface-3); }
  .lc-hud { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 22px; padding: 12px 20px 14px; border-top: 1px solid var(--border); background: color-mix(in srgb, var(--surface-2) 55%, transparent); }
  .hud-item { display: flex; flex-direction: column; min-width: 92px; }
  .hud-k { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-faint); font-weight: 600; }
  .hud-v { font-family: var(--font-mono); font-size: 0.86rem; font-variant-numeric: tabular-nums; }
  .hud-btn { margin-left: auto; }
</style>
