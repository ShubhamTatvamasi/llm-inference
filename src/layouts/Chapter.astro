---
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import { chapters, parts, chapterIndex } from '../data/chapters';
import { chapterUrl, u } from '../lib/url';
import { connections } from '../data/graph';
import { readingMinutes, vizTitles } from '../data/content';
import { paths } from '../data/paths';

interface Props {
  frontmatter?: { title?: string; description?: string };
  headings?: { depth: number; slug: string; text: string }[];
}
const { frontmatter = {}, headings = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const slug = Astro.url.pathname.replace(base, '').replace(/^\/|\/$/g, '');
const idx = chapterIndex(slug);
const ch = chapters[idx];
if (!ch) throw new Error(`Chapter "${slug}" is not registered in src/data/chapters.ts`);
const part = parts.find((p) => p.id === ch.part)!;
const prev = chapters[idx - 1];
const next = chapters[idx + 1];
const num = String(idx + 1).padStart(2, '0');
const toc = headings.filter((h) => h.depth === 2);
const conn = connections(slug);
const minutes = readingMinutes(slug);
const nViz = vizTitles(slug).length;
const title = frontmatter.title ?? ch.title;
const description = frontmatter.description ?? ch.blurb;
const pageUrl = new URL(chapterUrl(slug), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle', headline: title, description, url: pageUrl, inLanguage: 'en',
      articleSection: part.title, position: idx + 1, timeRequired: `PT${minutes}M`,
      image: new URL(u('og.png'), Astro.site).href,
      isPartOf: { '@type': 'WebSite', name: 'Token by Token', url: new URL(u(), Astro.site).href },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Token by Token', item: new URL(u(), Astro.site).href },
        { '@type': 'ListItem', position: 2, name: `Part ${part.num} · ${part.title}` },
        { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
      ],
    },
  ],
};
// paths that include this chapter: the reader's chosen one shows "next in your path" above the pager
const myPaths = paths.filter((p) => p.steps.includes(slug)).map((p) => {
  const i = p.steps.indexOf(slug); const nx = p.steps[i + 1];
  return { id: p.id, title: p.title, i: i + 1, n: p.steps.length, next: nx ? { t: chapters[chapterIndex(nx)].title, h: chapterUrl(nx) } : null };
});
// short chapter labels for the glossary pop-over's "Learn more" link
const shorts = Object.fromEntries(chapters.map((c) => [c.slug, c.short]));
---
<Base title={title} description={description} ogType="article">
  <Fragment slot="head">
    {prev && <link rel="prev" href={chapterUrl(prev.slug)} />}
    {next && <link rel="next" href={chapterUrl(next.slug)} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </Fragment>
  <div class="shell">
    <Sidebar current={slug} />
    <main class="main" id="main" data-chapter={slug}>
      <article class="prose">
        <header class="ch-head">
          <div class="ch-meta">
            <span class="ch-part">Part {part.num} · {part.title}</span>
            <span class="ch-num">Chapter {num} / {chapters.length}</span>
            <span class="ch-num ch-time" title="Reading time, including time to try the diagrams">{minutes} min{nViz > 0 && ` · ${nViz} interactive diagram${nViz > 1 ? 's' : ''}`}</span>
          </div>
          <h1>{ch.title}</h1>
          <p class="ch-lede">{description}</p>
        </header>
        {toc.length > 2 && (
          <details class="toc-inline">
            <summary>On this page <span>{toc.length} sections</span></summary>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </details>
        )}
        <slot />
      </article>

      {(conn.before.length > 0 || conn.after.length > 0) && (
        <section class="conn" aria-label="How this chapter connects">
          {conn.before.length > 0 && (
            <div class="conn-col">
              <span class="conn-h pre">Builds on</span>
              {conn.before.map((s) => <a href={chapterUrl(s)}><span class="cn">{String(chapterIndex(s) + 1).padStart(2, '0')}</span>{chapters[chapterIndex(s)].short}</a>)}
            </div>
          )}
          {conn.after.length > 0 && (
            <div class="conn-col">
              <span class="conn-h post">Comes up again in</span>
              {conn.after.map((s) => <a href={chapterUrl(s)}><span class="cn">{String(chapterIndex(s) + 1).padStart(2, '0')}</span>{chapters[chapterIndex(s)].short}</a>)}
            </div>
          )}
          <a class="conn-map" href={u('map/')}>See it on the concept map →</a>
        </section>
      )}

      <a class="path-next" data-path-next hidden></a>
      <script is:inline type="application/json" id="path-data" set:html={JSON.stringify({ paths: myPaths, home: u('paths/') })} />

      <nav class="pager" aria-label="Chapter navigation">
        {prev ? (
          <a class="pg prev" href={chapterUrl(prev.slug)}><span class="pg-k">← Previous</span><span class="pg-t">{prev.title}</span></a>
        ) : <span />}
        {next ? (
          <a class="pg next" href={chapterUrl(next.slug)}><span class="pg-k">Next →</span><span class="pg-t">{next.title}</span></a>
        ) : <span />}
      </nav>
      <footer class="foot">Token by Token · LLM inference &amp; serving, visualized</footer>
    </main>
    {toc.length > 2 && (
      <aside class="toc" aria-label="On this page">
        <div class="toc-h">On this page</div>
        <ul>{toc.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}</ul>
      </aside>
    )}
  </div>
  <script is:inline type="application/json" id="gl-data" set:html={JSON.stringify({ slug, base: u(), shorts })} />
  <div class="gl-pop" role="tooltip" id="gl-pop" hidden></div>
  <script>
    import { loadSearchIndex } from '../lib/search';
    // Glossary: wrap the first mention of each term in the prose with a hover/tap definition.
    // The definitions come from the shared search index (one cached download for the whole site).
    type G = { t: string; a: string[]; d: string; h: string; c: string };
    const cfg: { slug: string; base: string; shorts: Record<string, string> } = JSON.parse(document.getElementById('gl-data')?.textContent || '{}');
    const prose = document.querySelector<HTMLElement>('.prose');
    const idle = (cb: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(cb, { timeout: 1500 }) : setTimeout(cb, 200));
    if (prose) idle(() => loadSearchIndex().then((idx) => {
      // skip the terms this chapter itself teaches, and the very common words marked hover: false
      const terms: G[] = idx.filter((it) => it.k === 'g' && it.c !== cfg.slug && !it.x)
        .map((it) => ({ t: it.t, a: it.a ?? [], d: it.b, h: `${cfg.base}${it.c}/`, c: cfg.shorts[it.c!] ?? '' }));
      if (terms.length) wrap(prose, terms);
    }, () => {}));
    function wrap(prose: HTMLElement, terms: G[]) {
      const esc = (x: string) => x.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const forms: { re: RegExp; g: G }[] = [];
      for (const g of terms) for (const f of [g.t, ...g.a]) {
        const caps = f === f.toUpperCase() && /[A-Z]/.test(f);
        forms.push({ re: new RegExp(`(^|[^\\w-])(${esc(f)})(?![\\w-])`, caps ? '' : 'i'), g });
      }
      forms.sort((x, y) => y.re.source.length - x.re.source.length); // prefer longer phrases
      const SKIP = 'h1,h2,h3,h4,a,code,pre,kbd,.katex,.viz,.interview,summary,.chip,.gl,.conn,.ch-head,.toc-inline,table th';
      const done = new Set<G>();
      const walker = document.createTreeWalker(prose, NodeFilter.SHOW_TEXT, {
        acceptNode: (n) => (n.parentElement?.closest(SKIP) ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT),
      });
      const nodes: Text[] = [];
      while (walker.nextNode()) nodes.push(walker.currentNode as Text);
      for (const node of nodes) {
        let cur: Text | null = node;
        while (cur && done.size < terms.length) {
          let best: { i: number; len: number; g: G } | null = null;
          for (const f of forms) {
            if (done.has(f.g)) continue;
            const m = f.re.exec(cur.data);
            if (m) { const i = m.index + m[1].length; if (!best || i < best.i) best = { i, len: m[2].length, g: f.g }; }
          }
          if (!best) break;
          const mid = cur.splitText(best.i); const rest = mid.splitText(best.len);
          const el = document.createElement('span');
          el.className = 'gl'; el.tabIndex = 0; el.dataset.gl = String(terms.indexOf(best.g));
          el.setAttribute('aria-describedby', 'gl-pop');
          el.textContent = mid.data; mid.replaceWith(el);
          done.add(best.g); cur = rest;
        }
      }
      const pop = document.getElementById('gl-pop')!;
      let hideT = 0;
      const show = (el: HTMLElement) => {
        clearTimeout(hideT);
        const g = terms[Number(el.dataset.gl)];
        pop.innerHTML = `<b></b><p></p><a></a>`;
        pop.querySelector('b')!.textContent = g.t;
        pop.querySelector('p')!.textContent = g.d;
        const a = pop.querySelector('a')!; a.href = g.h; a.textContent = `Learn more: ${g.c} →`;
        pop.hidden = false;
        const r = el.getBoundingClientRect(); const pw = Math.min(320, innerWidth - 24);
        pop.style.width = pw + 'px';
        pop.style.left = Math.max(12, Math.min(innerWidth - pw - 12, r.left + r.width / 2 - pw / 2)) + 'px';
        const below = r.bottom + 8 + pop.offsetHeight < innerHeight;
        pop.style.top = (below ? r.bottom + 8 : r.top - pop.offsetHeight - 8) + 'px';
      };
      const hide = () => { hideT = window.setTimeout(() => { pop.hidden = true; }, 160); };
      prose.addEventListener('mouseover', (e) => { const el = (e.target as HTMLElement).closest<HTMLElement>('.gl'); if (el) show(el); });
      prose.addEventListener('mouseout', (e) => { if ((e.target as HTMLElement).closest('.gl')) hide(); });
      prose.addEventListener('focusin', (e) => { const el = (e.target as HTMLElement).closest<HTMLElement>('.gl'); if (el) show(el); });
      prose.addEventListener('focusout', hide);
      prose.addEventListener('click', (e) => { const el = (e.target as HTMLElement).closest<HTMLElement>('.gl'); if (el) { e.preventDefault(); show(el); } });
      pop.addEventListener('mouseenter', () => clearTimeout(hideT));
      pop.addEventListener('mouseleave', hide);
      addEventListener('scroll', () => { pop.hidden = true; }, { passive: true });
      addEventListener('keydown', (e) => { if (e.key === 'Escape') pop.hidden = true; });
    }
  </script>
  <script>
    // mark visited + remember where the reader is, so the home page can offer "Continue reading"
    const main = document.querySelector<HTMLElement>('[data-chapter]');
    if (main) {
      try {
        const k = 'tbt-visited';
        const set = new Set<string>(JSON.parse(localStorage.getItem(k) || '[]'));
        set.add(main.dataset.chapter!);
        localStorage.setItem(k, JSON.stringify([...set]));
        localStorage.setItem('tbt-last', main.dataset.chapter!);
      } catch {}
    }
    // following a learning path: show the position in it and its next chapter
    try {
      const pd: { paths: { id: string; title: string; i: number; n: number; next: { t: string; h: string } | null }[]; home: string } = JSON.parse(document.getElementById('path-data')!.textContent!);
      const mine = pd.paths.find((p) => p.id === localStorage.getItem('tbt-path'));
      const el = document.querySelector<HTMLAnchorElement>('[data-path-next]');
      if (mine && el) {
        el.href = mine.next ? mine.next.h : `${pd.home}#${mine.id}`;
        const k = document.createElement('span'); k.className = 'pn-k'; k.textContent = `Your path: ${mine.title} · step ${mine.i} of ${mine.n}`;
        const t = document.createElement('span'); t.className = 'pn-t'; t.textContent = mine.next ? `Next in path: ${mine.next.t} →` : 'Last chapter of this path. See your progress →';
        el.append(k, t); el.hidden = false;
      }
    } catch {}
    // a link straight to an interview question (from search or the Review deck) opens it
    const openTarget = () => {
      const el = location.hash.length > 1 ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
      if (el instanceof HTMLDetailsElement) el.open = true;
    };
    openTarget(); addEventListener('hashchange', openTarget);
    // a "#" link on every section heading: click to put a shareable link in the address bar
    document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]').forEach((hd) => {
      const a = document.createElement('a');
      a.className = 'h-anchor'; a.href = `#${hd.id}`; a.textContent = '#';
      a.setAttribute('aria-label', `Link to section “${hd.textContent}”`);
      hd.appendChild(a);
    });
    // the inline contents list closes after a jump so it does not sit open above the reader
    document.querySelector<HTMLDetailsElement>('.toc-inline')?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) (e.currentTarget as HTMLDetailsElement).open = false;
    });
    // highlight current heading in TOC
    const links = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>('[data-toc]').forEach((a) => links.set(a.dataset.toc!, a));
    if (links.size) {
      const hs = [...document.querySelectorAll<HTMLElement>('.prose h2[id]')];
      const io = new IntersectionObserver(() => {
        let cur = hs[0]?.id;
        for (const h of hs) if (h.getBoundingClientRect().top < 140) cur = h.id;
        links.forEach((a, id) => a.classList.toggle('on', id === cur));
      }, { rootMargin: '0px 0px -60% 0px' });
      hs.forEach((h) => io.observe(h));
      addEventListener('scroll', () => {
        let cur = hs[0]?.id;
        for (const h of hs) if (h.getBoundingClientRect().top < 140) cur = h.id;
        links.forEach((a, id) => a.classList.toggle('on', id === cur));
      }, { passive: true });
    }
  </script>
  <style>
    .shell { display: grid; grid-template-columns: var(--sidebar-w) minmax(0, 1fr); max-width: 1600px; margin: 0 auto; }
    .main { padding: 36px 48px 80px; min-width: 0; }
    .ch-head { margin: 8px 0 2.2rem; padding-bottom: 1.6rem; border-bottom: 1px solid var(--border); }
    .ch-meta { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 16px; font-size: 0.78rem; }
    .ch-part { color: var(--accent); font-weight: 600; padding: 3px 10px; border-radius: 999px; background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent); }
    .ch-num { color: var(--text-faint); font-family: var(--font-mono); font-size: 0.72rem; }
    .ch-time::before { content: '·'; margin-right: 10px; }
    .toc-inline { margin: -0.8rem 0 2rem; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); font-size: 0.9rem; }
    .toc-inline summary { cursor: pointer; padding: 10px 14px; font-weight: 600; color: var(--text-dim); list-style: none; display: flex; align-items: center; gap: 10px; }
    .toc-inline summary::-webkit-details-marker { display: none; }
    .toc-inline summary::before { content: ''; width: 7px; height: 7px; border-right: 1.6px solid currentColor; border-bottom: 1.6px solid currentColor; transform: rotate(-45deg); transition: transform 0.15s; }
    .toc-inline[open] summary::before { transform: rotate(45deg); }
    .toc-inline summary:hover { color: var(--text); }
    .toc-inline summary span { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 450; color: var(--text-faint); }
    .toc-inline ol { margin: 0; padding: 2px 14px 12px 38px; columns: 2 240px; column-gap: 28px; color: var(--text-faint); font-size: 0.86rem; }
    .toc-inline li { margin: 0; padding: 3px 0; break-inside: avoid; }
    .toc-inline a { color: var(--text-dim); }
    .toc-inline a:hover { color: var(--text); }
    :global(.h-anchor) { margin-left: 0.4em; color: var(--text-faint); font-weight: 450; opacity: 0; background: none; transition: opacity 0.15s, color 0.15s; }
    :global(.prose :is(h2, h3):hover .h-anchor), :global(.h-anchor:focus-visible) { opacity: 1; }
    :global(.h-anchor:hover) { color: var(--accent); background: none; }
    @media (hover: none) { :global(.h-anchor) { opacity: 0.55; } }
    .ch-lede { font-size: 1.16rem; color: var(--text-dim) !important; line-height: 1.6; margin: 0 !important; max-width: 640px; }
    :global(.gl) { text-decoration: underline dotted color-mix(in srgb, var(--accent) 70%, transparent); text-underline-offset: 3px; text-decoration-thickness: 1.5px; cursor: help; border-radius: 3px; }
    :global(.gl:hover), :global(.gl:focus-visible) { background: var(--accent-soft); outline: none; }
    .gl-pop { position: fixed; z-index: 80; padding: 11px 13px; border-radius: 12px; background: var(--surface-solid); border: 1px solid var(--border-strong); box-shadow: 0 18px 40px -12px rgba(0,0,0,0.45); font-size: 0.86rem; line-height: 1.5; }
    .gl-pop :global(b) { display: block; color: var(--accent); font-size: 0.9rem; margin-bottom: 2px; }
    .gl-pop :global(p) { margin: 0 0 6px; color: var(--text-dim); }
    .gl-pop :global(a) { font-size: 0.8rem; }
    .conn { max-width: var(--prose-w); margin: 3rem 0 0; display: flex; flex-wrap: wrap; gap: 14px 28px; padding: 16px 18px; border: 1px solid var(--border); border-radius: 14px; background: var(--surface); }
    .conn-col { display: flex; flex-direction: column; gap: 3px; min-width: 200px; flex: 1; }
    .conn-h { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.09em; font-weight: 650; margin-bottom: 4px; }
    .conn-h.pre { color: var(--c-prefill); } .conn-h.post { color: var(--c-decode); }
    .conn-col a { font-size: 0.9rem; color: var(--text-dim); display: flex; gap: 8px; align-items: baseline; }
    .conn-col a:hover { color: var(--text); }
    .conn .cn { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-faint); }
    .conn-map { flex-basis: 100%; font-size: 0.82rem; }
    .path-next { max-width: var(--prose-w); margin: 3rem 0 0; display: flex; flex-direction: column; gap: 3px; padding: 14px 18px; border-radius: 14px; border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent); background: var(--accent-soft); color: var(--text); }
    .path-next[hidden] { display: none; }
    .path-next:hover { border-color: var(--accent); background-size: 0 0; }
    .path-next :global(.pn-k) { font-size: 0.76rem; color: var(--text-dim); }
    .path-next :global(.pn-t) { font-weight: 620; }
    .path-next + script + .pager { margin-top: 14px; }
    .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; max-width: var(--prose-w); margin: 3.5rem 0 0; }
    .pg { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; border: 1px solid var(--border); border-radius: 14px; background: var(--surface); color: var(--text); transition: border-color 0.2s, transform 0.2s; }
    .pg:hover { border-color: var(--accent); transform: translateY(-2px); background-size: 0 0; }
    .pg.next { text-align: right; }
    .pg-k { font-size: 0.78rem; color: var(--text-faint); }
    .pg-t { font-weight: 620; }
    .foot { max-width: var(--prose-w); margin-top: 3rem; padding-top: 1.4rem; border-top: 1px solid var(--border); color: var(--text-faint); font-size: 0.82rem; }
    .toc { display: none; }
    @media (min-width: 1700px) {
      .shell { grid-template-columns: var(--sidebar-w) minmax(0, 1fr) 220px; max-width: 1840px; }
      .toc-inline { display: none; }
      .toc { display: block; position: sticky; top: calc(var(--header-h) + 36px); align-self: start; padding: 8px 20px 0 0; max-height: calc(100vh - 120px); overflow-y: auto; }
      .toc-h { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-faint); font-weight: 650; margin-bottom: 10px; }
      .toc ul { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--border); }
      .toc a { display: block; padding: 4px 0 4px 14px; margin-left: -1px; font-size: 0.82rem; color: var(--text-dim); border-left: 1px solid transparent; background: none; line-height: 1.4; }
      .toc a:hover { color: var(--text); }
      .toc a.on { color: var(--accent); border-left-color: var(--accent); }
    }
    @media (max-width: 960px) {
      .shell { grid-template-columns: minmax(0, 1fr); }
      .main { padding: 24px 18px 60px; }
    }
    @media (max-width: 560px) { .pager { grid-template-columns: 1fr; } }
  </style>
</Base>
