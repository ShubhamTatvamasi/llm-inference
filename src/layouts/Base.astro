---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { u } from '../lib/url';
import { tools, toolSvg } from '../data/tools';

interface Props { title?: string; description?: string; wide?: boolean; ogType?: 'website' | 'article' }
const SITE = 'Token by Token';
const { title, ogType = 'website', description = 'LLM inference and serving, visualized: interactive, technical diagrams of every stage of an LLM request — from tokenization to GPU kernels to production serving.' } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '').split('/').pop();
const fullTitle = title ? `${title} · ${SITE}` : `${SITE} — LLM inference & serving, visualized`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(u('og.png'), Astro.site).href; // public/og.png: 1200×630 social preview card
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={u('favicon.svg')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Token by Token: LLM inference & serving, visualized" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" type="application/xml" href={u('sitemap.xml')} />
    <meta name="theme-color" content="#06070d" />
    <slot name="head" />
    <!-- prefetch a page when a link to it is hovered or pressed, so chapter-to-chapter navigation is instant -->
    <script is:inline type="speculationrules" set:html={JSON.stringify({ prefetch: [{ where: { href_matches: `${u()}*` }, eagerness: 'moderate' }] })} />
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('tbt-theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"><div class="progress-bar"></div></div>
    <header class="topbar">
      <div class="topbar-in">
        <button class="icon-btn nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" data-nav-toggle>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M3 6h14M3 10h14M3 14h14"/></svg>
        </button>
        <a class="brand" href={u()}>
          <span class="logo" aria-hidden="true">
            <svg viewBox="0 0 32 32"><defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#a78bfa"/><stop offset="1" stop-color="#22d3ee"/></linearGradient></defs><rect x="1" y="1" width="30" height="30" rx="8" fill="none" stroke="url(#lg)" stroke-width="1.6"/><g stroke-linecap="round" stroke-width="2.6"><path d="M8.5 22V10" stroke="#fbbf24"/><path d="M13.5 22v-7" stroke="#fbbf24"/><path d="M18.5 22v-3" stroke="#38bdf8"/><path d="M23.5 22v-1" stroke="#38bdf8"/></g><circle cx="23.5" cy="11" r="2.4" fill="#34d399"/></svg>
          </span>
          <span class="brand-name">Token<span class="by"> by </span>Token</span>
        </a>
        <nav class="top-nav" aria-label="Tools">
          {tools.map((t) => (
            <a href={u(`${t.slug}/`)} class={here === t.slug ? 'on' : ''} aria-current={here === t.slug ? 'page' : undefined} title={t.title}>
              <Fragment set:html={toolSvg(t)} /><span>{t.label}</span>
            </a>
          ))}
        </nav>
        <div class="spacer"></div>
        <button class="search-btn" type="button" data-palette-open aria-label="Search chapters, sections, diagrams and terms" aria-keyshortcuts="Meta+K Control+K /">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="9" cy="9" r="5.5"/><path d="m13.2 13.2 3.3 3.3"/></svg>
          <span class="sb-label">Search the guide…</span>
          <kbd class="sb-kbd">⌘K</kbd>
        </button>
        <div class="theme-switch" role="radiogroup" aria-label="Colour theme" data-theme-switch>
          <span class="ts-thumb" aria-hidden="true"></span>
          <button type="button" role="radio" data-theme-opt="system" aria-label="System theme" title="System">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="3.5" width="15" height="10" rx="1.8"/><path d="M7 17h6M10 13.5V17"/></svg>
          </button>
          <button type="button" role="radio" data-theme-opt="light" aria-label="Light theme" title="Light">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="10" cy="10" r="3.4"/><path d="M10 2v1.8M10 16.2V18M2 10h1.8M16.2 10H18M4.3 4.3l1.3 1.3M14.4 14.4l1.3 1.3M4.3 15.7l1.3-1.3M14.4 5.6l1.3-1.3"/></svg>
          </button>
          <button type="button" role="radio" data-theme-opt="dark" aria-label="Dark theme" title="Dark">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M16.5 12.2A6.8 6.8 0 0 1 7.8 3.5a6.8 6.8 0 1 0 8.7 8.7Z"/></svg>
          </button>
        </div>
      </div>
    </header>

    <slot />

    <!-- command palette -->
    <div class="palette" data-palette data-search-src={u('search.json')} hidden>
      <div class="palette-backdrop" data-palette-close></div>
      <div class="palette-box" role="dialog" aria-modal="true" aria-label="Search the guide">
        <div class="palette-input">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="9" cy="9" r="5.5"/><path d="m13.2 13.2 3.3 3.3"/></svg>
          <input type="text" placeholder="Chapters, sections, diagrams and terms — try “kv”, “ttft”, “roofline”…" data-palette-input autocomplete="off" spellcheck="false" role="combobox" aria-expanded="true" aria-controls="palette-list" aria-autocomplete="list" aria-label="Search the guide" />
          <kbd>esc</kbd>
        </div>
        <ul class="palette-list" id="palette-list" role="listbox" aria-label="Results" data-palette-list></ul>
        <div class="palette-foot" aria-hidden="true"><span><kbd>↑</kbd><kbd>↓</kbd> move</span><span><kbd>↵</kbd> open</span><span><kbd>[</kbd><kbd>]</kbd> previous / next chapter</span></div>
      </div>
    </div>

    <script>
      import { loadSearchIndex, searchItems, type SearchItem } from '../lib/search';
      // theme: system | light | dark
      const root = document.documentElement;
      const applyTheme = (mode: string) => {
        if (mode === 'light' || mode === 'dark') root.dataset.theme = mode; else delete root.dataset.theme;
        document.querySelectorAll<HTMLElement>('[data-theme-switch]').forEach((sw) => {
          sw.dataset.mode = mode;
          sw.querySelectorAll<HTMLElement>('[data-theme-opt]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.themeOpt === mode)));
        });
        const dark = mode === 'dark' || (mode === 'system' && !matchMedia('(prefers-color-scheme: light)').matches);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#06070d' : '#fbfbfd');
      };
      let themeMode = 'system';
      try { themeMode = localStorage.getItem('tbt-theme') || 'system'; } catch {}
      applyTheme(themeMode);
      document.querySelectorAll<HTMLElement>('[data-theme-opt]').forEach((b) => b.addEventListener('click', () => {
        themeMode = b.dataset.themeOpt!;
        const go = () => { applyTheme(themeMode); try { localStorage.setItem('tbt-theme', themeMode); } catch {} };
        const d = document as Document & { startViewTransition?: (cb: () => void) => unknown };
        if (d.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.startViewTransition(go); else go();
      }));
      matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => applyTheme(themeMode));

      // keyboard: [ and ] for previous / next chapter
      addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey || e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement || e.target instanceof HTMLSelectElement) return;
        if (e.key === '[') document.querySelector<HTMLAnchorElement>('.pg.prev')?.click();
        if (e.key === ']') document.querySelector<HTMLAnchorElement>('.pg.next')?.click();
      });

      // reading progress
      const bar = document.querySelector<HTMLElement>('.progress-bar');
      const onScroll = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        if (bar) bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
        document.body.classList.toggle('scrolled', scrollY > 8);
      };
      addEventListener('scroll', onScroll, { passive: true }); onScroll();

      // mobile nav
      const navToggles = document.querySelectorAll<HTMLElement>('[data-nav-toggle]');
      const setNav = (open: boolean) => {
        document.body.classList.toggle('nav-open', open);
        navToggles.forEach((b) => b.setAttribute('aria-expanded', String(open)));
      };
      navToggles.forEach((b) => b.addEventListener('click', () => setNav(!document.body.classList.contains('nav-open'))));
      document.querySelectorAll('[data-nav-close]').forEach((b) => b.addEventListener('click', () => setNav(false)));
      addEventListener('keydown', (e) => { if (e.key === 'Escape' && document.body.classList.contains('nav-open')) { setNav(false); navToggles[0]?.focus(); } });

      // command palette: the index is one shared, cached JSON file, fetched the first time it is needed
      const pal = document.querySelector<HTMLElement>('[data-palette]')!;
      const input = pal.querySelector<HTMLInputElement>('[data-palette-input]')!;
      const list = pal.querySelector<HTMLUListElement>('[data-palette-list]')!;
      let items: SearchItem[] | null = null; let failed = false;
      let sel = 0; let shown: SearchItem[] = []; let opener: HTMLElement | null = null;
      const esc = (x: string) => x.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
      const mark = () => {
        list.querySelectorAll<HTMLElement>('[role="option"]').forEach((a, i) => { a.classList.toggle('sel', i === sel); a.setAttribute('aria-selected', String(i === sel)); });
        if (shown.length) input.setAttribute('aria-activedescendant', `pal-${sel}`); else input.removeAttribute('aria-activedescendant');
      };
      const render = () => {
        list.innerHTML = !items
          ? `<li class="empty">${failed ? 'Search could not load. Check your connection and try again.' : 'Loading…'}</li>`
          : shown.map((it, i) => `<li role="presentation"><a href="${esc(it.h)}" id="pal-${i}" role="option" data-i="${i}" data-kind="${it.k}"><span class="pn">${esc(it.n)}</span><span class="pt"><b>${esc(it.t)}</b><small>${esc(it.b)}</small></span><span class="pp">${esc(it.p)}</span></a></li>`).join('')
            || '<li class="empty">Nothing matches. Try a shorter word.</li>';
        mark();
        list.querySelector('.sel')?.scrollIntoView({ block: 'nearest' });
      };
      const filter = () => { shown = items ? searchItems(items, input.value) : []; sel = 0; render(); };
      const ensure = () => {
        if (items) return;
        failed = false;
        loadSearchIndex().then((d) => { items = d; filter(); }, () => { failed = true; render(); });
      };
      const open = () => {
        opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        pal.hidden = false; input.value = ''; ensure(); filter(); requestAnimationFrame(() => input.focus());
      };
      const close = () => { pal.hidden = true; opener?.focus(); opener = null; };
      const move = (d: number) => { if (!shown.length) return; sel = (sel + d + shown.length) % shown.length; mark(); list.querySelector('.sel')?.scrollIntoView({ block: 'nearest' }); };
      document.querySelectorAll<HTMLElement>('[data-palette-open]').forEach((b) => {
        b.addEventListener('click', open);
        b.addEventListener('pointerenter', ensure, { once: true }); // warm the index before the click lands
      });
      pal.querySelectorAll('[data-palette-close]').forEach((b) => b.addEventListener('click', close));
      input.addEventListener('input', filter);
      list.addEventListener('pointermove', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLElement>('[data-i]');
        if (a && Number(a.dataset.i) !== sel) { sel = Number(a.dataset.i); mark(); }
      });
      // a result on the page you are already on only changes the hash, so close the palette ourselves
      list.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) pal.hidden = true; });
      addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); pal.hidden ? open() : close(); return; }
        const typing = e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement || e.target instanceof HTMLSelectElement;
        if (e.key === '/' && pal.hidden && !typing && !e.metaKey && !e.ctrlKey && !e.altKey) { e.preventDefault(); open(); return; }
        if (pal.hidden) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
        else if (e.key === 'Tab') { e.preventDefault(); input.focus(); } // keep focus inside the dialog
        else if (e.key === 'Enter' && shown[sel]) { e.preventDefault(); list.querySelector<HTMLAnchorElement>('.sel')?.click(); }
      });
    </script>

    <style is:global>
      .progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 60; pointer-events: none; }
      .progress-bar { height: 100%; background: var(--accent-grad); transform-origin: 0 50%; transform: scaleX(0); }
      .topbar { position: sticky; top: 0; z-index: 50; height: var(--header-h); border-bottom: 1px solid transparent; transition: background 0.2s, border-color 0.2s, backdrop-filter 0.2s; }
      body.scrolled .topbar, .topbar.solid { background: color-mix(in srgb, var(--bg) 72%, transparent); backdrop-filter: saturate(160%) blur(16px); -webkit-backdrop-filter: saturate(160%) blur(16px); border-bottom-color: var(--border); }
      .topbar-in { height: 100%; display: flex; align-items: center; gap: 10px; padding: 0 20px; max-width: 1600px; margin: 0 auto; }
      .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--text); font-weight: 680; letter-spacing: -0.02em; font-size: 1.02rem; background: none; }
      .brand:hover { background: none; }
      .logo { width: 28px; height: 28px; display: grid; }
      .brand-name { white-space: nowrap; }
      .brand-name .by { color: var(--text-faint); font-weight: 450; }
      @media (max-width: 400px) { .brand { font-size: 0.92rem; gap: 8px; } .topbar-in { padding: 0 12px; gap: 6px; } }
      .spacer { flex: 1; }
      .top-nav { display: flex; align-items: center; gap: 2px; margin-left: 18px; padding-left: 16px; border-left: 1px solid var(--border); height: 24px; }
      .top-nav a { display: inline-flex; align-items: center; gap: 7px; height: 34px; padding: 0 11px; border-radius: 9px; color: var(--text-dim); font-size: 0.86rem; font-weight: 560; background: none; white-space: nowrap; transition: color 0.15s, background 0.15s; }
      .top-nav a:hover { color: var(--text); background: var(--surface-2); }
      .top-nav a.on { color: var(--accent); background: var(--accent-soft); }
      .top-nav svg { width: 16px; height: 16px; flex: none; }
      @media (max-width: 1480px) { .search-btn { min-width: 200px; } }
      @media (max-width: 1400px) { .top-nav svg { display: none; } .top-nav a { padding: 0 9px; } .top-nav { margin-left: 10px; padding-left: 10px; } }
      @media (max-width: 1220px) { .search-btn { min-width: 0; width: 36px; padding: 0; justify-content: center; } .sb-label, .sb-kbd { display: none; } }
      @media (max-width: 1080px) { .top-nav { display: none; } }
      .icon-btn { appearance: none; border: 1px solid var(--border); background: var(--surface); color: var(--text-dim); width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; cursor: pointer; transition: color 0.15s, border-color 0.15s; }
      .icon-btn:hover { color: var(--text); border-color: var(--border-strong); }
      .icon-btn svg { width: 18px; height: 18px; }
      .theme-switch { position: relative; display: inline-grid; grid-template-columns: repeat(3, 30px); height: 36px; padding: 3px; border: 1px solid var(--border); border-radius: 11px; background: var(--surface); }
      .theme-switch button { position: relative; z-index: 1; appearance: none; border: 0; background: transparent; color: var(--text-faint); display: grid; place-items: center; cursor: pointer; border-radius: 8px; transition: color 0.2s; }
      .theme-switch button:hover { color: var(--text); }
      .theme-switch button[aria-checked='true'] { color: var(--text); }
      .theme-switch button:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
      .theme-switch svg { width: 16px; height: 16px; }
      .ts-thumb { position: absolute; top: 3px; left: 3px; width: 30px; height: 28px; border-radius: 8px; background: var(--surface-3); box-shadow: 0 1px 2px rgba(0,0,0,0.2), inset 0 0 0 1px var(--border-strong); transition: transform 0.25s cubic-bezier(.3,.8,.3,1); }
      .theme-switch[data-mode='light'] .ts-thumb { transform: translateX(30px); }
      .theme-switch[data-mode='dark'] .ts-thumb { transform: translateX(60px); }
      .nav-toggle { display: none; }
      .search-btn { appearance: none; font: inherit; display: inline-flex; align-items: center; gap: 10px; height: 36px; padding: 0 8px 0 12px; min-width: 260px; border-radius: 10px; border: 1px solid var(--border); background: var(--surface); color: var(--text-faint); cursor: pointer; font-size: 0.86rem; transition: border-color 0.15s; }
      .search-btn:hover { border-color: var(--border-strong); color: var(--text-dim); }
      .search-btn svg { width: 16px; height: 16px; }
      .sb-label { flex: 1; text-align: left; }
      @media (max-width: 720px) { .search-btn { min-width: 0; width: 36px; padding: 0; justify-content: center; } .sb-label, .sb-kbd { display: none; } }

      .palette { position: fixed; inset: 0; z-index: 100; display: grid; place-items: start center; padding: 12vh 16px 16px; }
      .palette[hidden] { display: none; }
      .palette-backdrop { position: absolute; inset: 0; background: rgba(4, 6, 12, 0.6); backdrop-filter: blur(6px); animation: fade 0.15s; }
      .palette-box { position: relative; width: min(640px, 100%); background: var(--surface-solid); border: 1px solid var(--border-strong); border-radius: 16px; box-shadow: 0 30px 80px -20px rgba(0,0,0,0.6); overflow: hidden; animation: pop 0.18s cubic-bezier(.2,.9,.3,1.2); }
      @keyframes fade { from { opacity: 0; } } @keyframes pop { from { opacity: 0; transform: translateY(-8px) scale(0.98); } }
      .palette-input { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--border); color: var(--text-faint); }
      .palette-input svg { width: 18px; height: 18px; flex: none; }
      .palette-input input { flex: 1; border: 0; outline: 0; background: transparent; color: var(--text); font: inherit; font-size: 1rem; }
      .palette-list { list-style: none; margin: 0; padding: 6px; max-height: 56vh; overflow-y: auto; }
      .palette-list a { display: flex; align-items: center; gap: 12px; padding: 9px 10px; border-radius: 10px; color: var(--text); background: none; }
      .palette-list a.sel { background: var(--accent-soft); }
      .palette-list a[data-kind='s'] .pn, .palette-list a[data-kind='d'] .pn, .palette-list a[data-kind='q'] .pn { color: var(--accent); }
      .palette-foot { display: flex; flex-wrap: wrap; gap: 4px 16px; padding: 8px 14px; border-top: 1px solid var(--border); color: var(--text-faint); font-size: 0.72rem; }
      .palette-foot kbd { margin-right: 3px; }
      @media (max-width: 600px), (pointer: coarse) { .palette-foot { display: none; } }
      .skip-link { position: fixed; top: 8px; left: 8px; z-index: 200; padding: 8px 14px; border-radius: 10px; background: var(--surface-solid); border: 1px solid var(--accent); color: var(--text); font-size: 0.9rem; font-weight: 600; transform: translateY(-200%); }
      .skip-link:focus { transform: none; outline: 2px solid var(--accent); outline-offset: 2px; }
      .palette-list .pn { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-faint); width: 22px; }
      .palette-list .pt { flex: 1; display: flex; flex-direction: column; min-width: 0; line-height: 1.35; }
      .palette-list .pt b { font-weight: 600; font-size: 0.92rem; }
      .palette-list .pt small { color: var(--text-dim); font-size: 0.8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .palette-list .pp { font-size: 0.72rem; color: var(--text-faint); white-space: nowrap; }
      .palette-list .empty { padding: 18px; color: var(--text-faint); text-align: center; }
      @media (max-width: 600px) { .palette-list .pp { display: none; } }
    </style>
  </body>
</html>
