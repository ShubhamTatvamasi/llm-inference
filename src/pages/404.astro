---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Not found">
  <main style="min-height:70vh;display:grid;place-items:center;text-align:center;padding:40px 16px">
    <div>
      <div style="font-family:var(--font-mono);color:var(--accent);letter-spacing:.14em;font-size:.8rem">ERROR 404 · TOKEN NOT IN VOCAB</div>
      <h1 style="font-size:clamp(2.2rem,6vw,3.6rem);letter-spacing:-.04em;margin:14px 0 10px">This page was <span class="grad-text">never sampled.</span></h1>
      <p style="color:var(--text-dim);margin:0 0 26px">The probability of this URL was zero. Try search instead.</p>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
        <a class="btn primary" href={u()} style="padding:10px 16px">Back to the start</a>
        <button class="btn" type="button" data-palette-open style="padding:10px 16px"><kbd>⌘K</kbd> Search chapters</button>
      </div>
    </div>
  </main>
</Base>
